load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "account",
    srcs = [
        "src/directory.rs",
        "src/discovery.rs",
        "src/external.rs",
        "src/follower.rs",
        "src/lib.rs",
        "src/owner.rs",
        "src/publish.rs",
        "src/publish/audit.rs",
        "src/publish/integration.rs",
        "src/publish/owner.rs",
        "src/publish/read.rs",
        "src/publish/recovery.rs",
        "src/refresh.rs",
        "src/remote.rs",
        "src/replica.rs",
        "src/replica_control.rs",
        "src/replicated_source.rs",
        "src/service.rs",
        "src/view.rs",
        "src/wire.rs",
    ],
    crate_name = "codex_infra_account",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(),
)

rust_binary(
    name = "codex-infra-account",
    srcs = [
        "src/main.rs",
    ],
    crate_name = "codex_infra_account",
    crate_root = "src/main.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":account"] + all_crate_deps(),
)
