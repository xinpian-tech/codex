load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "infra",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    crate_name = "codex_infra_extension",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(),
)

rust_binary(
    name = "codex-agent",
    srcs = glob(["src/bin/**/*.rs"]),
    crate_root = "src/bin/codex-agent.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":infra"] + all_crate_deps(),
)
